[Unit]
# Panely uzak yedek yükleyicisi.
#
# ── Neden panelyd'nin İÇİNDE değil ───────────────────────────────────
#
# panelyd `IPAddressDeny=any` taşıyor ve hiçbir ağ hedefine ulaşamıyor
# (K-092'de kontrol gruplu ölçüldü). Bu, ele geçirilen bir kontrol
# düzleminin dışarı veri sızdırmasını engelliyor. Yükleme yeteneğini
# panelyd'ye eklemek o özelliği ortadan kaldırırdı.
#
# Ayrı birim, ayrı politika: burası ağ görüyor, panelyd görmüyor.
Description=Panely uzak yedek yükleyicisi
Documentation=file:/usr/local/lib/panely/offsite/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=panely
Group=panely

ExecStart=/usr/local/lib/panely/offsite/panely-offsite.sh

# rclone yapılandırmasının yeri SABİT ve root'un dizininde.
#
# Tanımsız bırakılsaydı rclone `$HOME/.config/rclone` altına bakardı;
# `panely`nin ev dizini /var/lib/panely, yani daemon'un yazabildiği
# dizin. Oradaki bir dosya root'a ait olsa bile daemon onu silip yerine
# kendisininkini koyabilir, ve rclone yapılandırması komut
# çalıştırabilir — ağı olmayan daemon'a ağ gören bir süreçte komut
# yolu (K-100). Betik de yolun sahipliğini ayrıca doğruluyor.
Environment=RCLONE_CONFIG=/etc/panely/rclone.conf

# ── Yedeklere YALNIZCA OKUMA ─────────────────────────────────────────
#
# Yükleyicinin yazma ihtiyacı yok. ProtectSystem=strict zaten her şeyi
# salt okunur yapıyor; burada ReadWritePaths VERİLMİYOR. Sonuç: bu
# süreç ele geçirilse bile yerel yedekleri BOZAMAZ.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Yetki gerekmiyor: uid 999, yalnızca dosya okuyup ağa yazıyor.
CapabilityBoundingSet=
AmbientCapabilities=

# ── Ağ: panelyd'den TEK farkı bu ─────────────────────────────────────
#
# Yükleyici internete çıkmak ZORUNDA. Ama yerel ağa erişimi
# engelleniyor: ele geçirilse bile konteyner ağını ya da host
# servislerini tarayamasın.
IPAddressDeny=localhost link-local multicast

# ── Tek istisna: DNS çözücüsü (K-107) ────────────────────────────────
#
# `localhost` engeli systemd-resolved'ın taslak çözücüsünü (127.0.0.53)
# de kapatıyor. rclone Go'nun kendi çözücüsünü kullanıyor ve
# /etc/resolv.conf'taki 127.0.0.53'e UDP ile soruyor; engel altında:
#
#   lookup ….r2.cloudflarestorage.com on 127.0.0.53:53:
#   write udp 127.0.0.1:…->127.0.0.53:53: write: operation not permitted
#
# Birim ilk GERÇEK ağ koşusunda bununla düştü. K-098'in sınaması yerel
# bir rclone hedefiyle yapılmıştı; ağ yolu hiç yürünmemişti.
#
# İzin YALNIZCA 127.0.0.53: geçici birimle ölçüldü — bu izinle R2
# listeleniyor, ama 127.0.0.1:22 hâlâ kapalı (kısıtsız süreçten açık:
# kontrol grubu). IPAddressAllow, IPAddressDeny'den önce gelir.
IPAddressAllow=127.0.0.53
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Düz metin yedek PrivateTmp içinde üretiliyor ve süreç bitince yok
# oluyor; kalıcı diske hiç yazılmıyor.
PrivateTmp=yes

# Ağ ve şifreleme yavaş olabilir ama sonsuz değil.
TimeoutStartSec=30min
