{
  "name": "kadran-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Kadran masaüstü kabuğu — kadran sidecar'ını çocuk süreç olarak çalıştırır",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "test:built": "node --test \"test/built/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "e2e": "node scripts/e2e.mjs",
    "build": "tsc && vite build && node scripts/copy-preload.mjs",
    "dev": "npm run build && electron ."
  },
  "dependencies": {
    "motion": "13.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "^43.7.8",
    "typescript": "^5.7.2",
    "vite": "8.3.3"
  },
  "engines": {
    "node": ">=22.6"
  }
}
