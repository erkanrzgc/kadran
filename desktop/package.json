{
  "name": "kadran-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Kadran masaüstü arayüzü — Wails kabuğuna gömülür (K-165)",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "test:built": "node --test \"test/built/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "build": "vite build",
    "e2e": "node scripts/smoke.ts",
    "dist": "npm run build && node scripts/dist.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "^5.7.2",
    "vite": "8.3.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
