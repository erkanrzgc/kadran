{
  // Kaynakta içe aktarımlar `.ts` uzantısıyla yazılıyor; böylece
  // `node --test` derleme olmadan doğrudan çalışabiliyor ve testler
  // bağımlılıksız kalıyor.
  //
  // rewriteRelativeImportExtensions (TS 5.7+) tsc çıktısında bu uzantıları
  // `.js`'e çeviriyor — Electron derlenmiş kodu çalıştırıyor. İki kip de
  // aynı kaynaktan besleniyor, ayrı bir dosya kopyası yok.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",

    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,

    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  // renderer/ burada derlenmiyor: Vite derliyor, tip denetimi
  // tsconfig.renderer.json'da (DOM + JSX). İki dünya ayrı tutuluyor.
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts"]
}
