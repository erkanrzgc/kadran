[Unit]
Description=Panely privileged executor (typed RPC whitelist)
Documentation=https://github.com/erkanrzgc/panely
After=docker.service
Wants=docker.service

[Service]
Type=notify
NotifyAccess=main
# Bayraklar açık; gerekçe için panelyd.service'teki nota bakın.
# --allow-user, executor'ın SO_PEERCRED ile kabul ettiği TEK kullanıcı.
ExecStart=/usr/local/lib/panely/panely-exec \
    --socket /run/panely-exec/exec.sock \
    --journal /var/lib/panely/exec-audit.log \
    --allow-user panely \
    --owner-group panely
Restart=on-failure
RestartSec=2s

# Executor ROOT çalışır — bu kaçınılmaz, çünkü Docker soketine erişim
# pratikte root yetkisidir. Modelin özü, bu ayrıcalığın ~1500 satırlık
# şema doğrulamalı bir yüzeye hapsedilmesidir.
User=root
Group=root

# ── Sıkılaştırma ─────────────────────────────────────────────────
# Root olsa bile gereksiz her şey kapatılır.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# # Bu filtre panelyd'ninkiyle KASTEN aynı değil — eşitlemeyin.
#
# panelyd `~@privileged` çıkarıyor, bu birim çıkarmıyor. Executor root
# çalışıyor ve soket/günlük sahipliklerini kurmak için chown'a ihtiyacı
# var. panelyd'de aynı çıkarma, api.sock'un grubunu ayarlarken
# SIGSYS/çökme döngüsü ürettiği için orada `@chown` ayrıca geri
# veriliyor (gerekçesi panelyd.service'te).
#
# İki birimi "tutarlılık" adına eşitlemek o çökmeyi geri getirir.
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @cpu-emulation @swap @reboot @raw-io

# Yalnızca unix soketi: Docker Engine API ve kendi dinleyicisi.
# Executor'ın ağa çıkması gerekmez; imaj çekme Docker daemon'ının işidir.
RestrictAddressFamilies=AF_UNIX

# Root'un tüm yeteneklerini almasına gerek yok. Hacim dizinlerinin
# sahipliğini ayarlamak için gerekenler dışında hepsi düşürülür.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE

# ProtectSystem=strict tüm dosya sistemini salt okunur yapar;
# yazılabilir alanlar burada tek tek açılır.
ReadWritePaths=/var/lib/panely
ReadWritePaths=/run/panely-exec

# Docker soketine erişim (ProtectSystem=strict /run'ı kapsamaz ama
# açıkça belirtmek niyeti belgelendirir).
#
# # Baştaki `-` neden ŞART?
#
# `-` olmadan systemd, kaynak yol yoksa ad alanını kuramaz ve birimi
# HİÇ başlatmaz:
#
#   Failed to set up mount namespacing: /run/docker.sock: No such file
#   or directory              → status=226/NAMESPACE
#
# Taze bir sunucuda Docker kurulu değil (Faz 0 kurmuyor; Docker
# sürücüsü Faz 1). Yani `-` olmadan bootstrap TAZE MAKİNEDE ÇALIŞMAZ —
# ve tam olarak böyle oldu: hata ancak gerçek sunucuda ortaya çıktı,
# çünkü WSL ve CI systemd ad alanı yalıtımını bu biçimde kurmuyor.
#
# Executor Docker yokluğunu zaten çalışma anında bildiriyor
# (internal/exec/dockerprobe.go); başlamamak yerine "Docker yok"
# demek doğru davranış.
BindReadOnlyPaths=-/run/docker.sock

UMask=0027

[Install]
WantedBy=multi-user.target
