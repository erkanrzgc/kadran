[Unit]
Description=Kadran Caddy raw admin — broker access only
Documentation=https://github.com/erkanrzgc/kadran

# systemd creates the raw socket before Caddy starts and passes fd/3.
# kadrand cannot traverse this directory or connect to this socket.
# kadran-proxy owns raw-admin access but never joins the kadran group,
# which would grant it access to the privileged executor socket.
[Socket]
ListenStream=/run/kadran-caddy/admin.sock
SocketUser=kadran-caddy
SocketGroup=kadran-proxy
SocketMode=0660
RemoveOnStop=yes
Service=kadran-caddy.service

[Install]
WantedBy=sockets.target
