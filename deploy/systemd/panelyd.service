[Unit]
Description=Panely control plane daemon
Documentation=https://github.com/erkanrzgc/panely
After=network-online.target panely-exec.service
Wants=network-online.target
Requires=panely-exec.service

[Service]
Type=notify
NotifyAccess=main
# Bayraklar AÇIK yazılıyor, varsayılana bırakılmıyor: bir varsayılanın
# kodda değişmesi üretim yapılandırmasını sessizce kaydırmamalı.
#
# Buradaki her bayrağın binary'de gerçekten TANIMLI olduğunu
# TestUnitExecStartFlagsExist doğruluyor. Gerekçesi somut: bu satır
# uzun süre `--config /etc/panely/panelyd.toml` diyordu — ne böyle bir
# bayrak ne de böyle bir dosya vardı. Hata ancak gerçek sunucuda
# ortaya çıktı (status=2/INVALIDARGUMENT, sonsuz yeniden başlatma).
ExecStart=/usr/local/lib/panely/panelyd \
    --socket /run/panely/api.sock \
    --exec-socket /run/panely-exec/exec.sock \
    --db /var/lib/panely/panely.db \
    --client-group panely-client
Restart=on-failure
RestartSec=2s

# YETKİSİZ. Bu satır ürünün tamamının dayandığı iddiadır.
# `sudo -u panely docker ps` BAŞARISIZ OLMAK ZORUNDADIR.
User=panely
Group=panely

# api.sock'u panely-client grubuna açabilmek için ek grup üyeliği.
# İstemci SSH kullanıcısı panely-client grubundadır; `panely` grubunda
# DEĞİLDİR — bu yüzden /run/panely-exec dizinini traverse edemez ve
# executor'a doğrudan ulaşamaz.
SupplementaryGroups=panely-client

# ── Sıkılaştırma ─────────────────────────────────────────────────
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @debug @cpu-emulation @swap @raw-io

# # @chown neden geri veriliyor?
#
# Daemon api.sock'un grubunu panely-client yapmak ZORUNDA; istemcinin
# sokete ulaşmasının tek yolu bu. Ama systemd'de chown ailesi
# @privileged içinde, ve yukarıdaki çıkarma @system-service'in verdiği
# @chown'u geri alıyor. Sonuç, gerçek sunucuda:
#
#   audit: ... comm="panelyd" sig=31 syscall=260   (fchownat)
#   panelyd.service: Main process exited, code=dumped, status=31/SYS
#
# Bu yalnızca gerçek çekirdek + gerçek systemd ile ortaya çıkar; WSL ve
# CI yakalayamaz.
#
# Verilen yetki neredeyse sıfır: süreç uid 999, CapabilityBoundingSet
# BOŞ, NoNewPrivileges=yes. Çekirdek, root olmayan bir sürecin chown'unu
# zaten sıkı kısıtlar — yalnızca SAHİBİ OLDUĞU dosyanın GRUBUNU, ve
# yalnızca ÜYESİ OLDUĞU bir gruba çevirebilir (panely, panely-client).
# Sahip değiştirmek hiçbir koşulda mümkün değil.
#
# Tek çağrı (fchownat) yerine aile veriliyor: Go'nun os.Chown'u ileride
# başka bir çağrı seçerse bu çökme döngüsü geri gelirdi.
SystemCallFilter=@chown

# Yetenek yok. Hiç.
CapabilityBoundingSet=
AmbientCapabilities=

# Faz 0'da daemon yalnızca unix soketleri kullanır: kendi api.sock'u ve
# executor'ın exec.sock'u.
# NOT: Faz 1'de sağlık denetçisi konteynerlere HTTP isteği atacağı için
# buraya AF_INET AF_INET6 eklenecek. Şimdiden eklemek gereksiz yüzey açar.
RestrictAddressFamilies=AF_UNIX

ReadWritePaths=/var/lib/panely
ReadWritePaths=/run/panely

UMask=0077

[Install]
WantedBy=multi-user.target
