{
  // Node tarafının tip denetimi (yalnız noEmit): paylaşılan türler, duman
  // testi ve paketleme betiği. Bunlar `node` ile derlemeden çalışıyor
  // (tür ayıklama); içe aktarımlar bu yüzden `.ts` uzantısıyla yazılıyor.
  // Arayüz ayrı: tsconfig.renderer.json (DOM + JSX), Vite derliyor.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,

    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/shared/**/*.ts", "scripts/smoke.ts", "scripts/dist.ts", "test/smoke/**/*.ts"]
}
